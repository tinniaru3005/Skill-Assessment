# ── Required ─────────────────────────────────────────────────────────────
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/REChain?retryWrites=true&w=majority
JWT_SECRET=your_super_secure_jwt_secret_here
PORT=4000
NODE_ENV=development

# ── Admin account ────────────────────────────────────────────────────────
ADMIN_EMAIL=admin@rechain.com
ADMIN_PASSWORD=your_secure_admin_password

# ── CORS / allowed origins ───────────────────────────────────────────────
WEBSITE_URL=http://localhost:5173
FRONTEND_URL=http://localhost:5173
ADMIN_URL=http://localhost:5174
LOCAL_URLS=http://localhost:5173,http://localhost:5174,http://localhost:4000
EXTRA_ALLOWED_ORIGINS=

# ── Email (Brevo SMTP) ───────────────────────────────────────────────────
EMAIL=your_sender_email@domain.com
EMAIL_USER=your_brevo_smtp_login
BREVO_API_KEY=your_brevo_api_key

# ── Image storage (ImageKit) ─────────────────────────────────────────────
IMAGEKIT_PUBLIC_KEY=public_your_imagekit_public_key
IMAGEKIT_PRIVATE_KEY=private_your_imagekit_private_key
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_imagekit_id

# ── AI Property Hub + AI Chat Assistant ──────────────────────────────────
# NOTE: these are server-side fallbacks only. By design, both the AI Hub
# search and the AI Chat Assistant require the user's OWN keys sent as
# X-Github-Key / X-Firecrawl-Key request headers - the server never uses
# these env vars as a silent fallback (see resolveServices() in
# controller/propertyController.js). Leave them unset unless you're running
# your own scripts/tests directly against the AI services.
GITHUB_MODELS_API_KEY=
FIRECRAWL_API_KEY=

# ── Rate limiting (optional; sane defaults if unset) ─────────────────────
RATE_LIMIT_STORE_PATH=./.rate-limit-store
CHAT_RATE_LIMIT_STORE_PATH=./.rate-limit-store-chat
CACHE_TTL_SECONDS=

# ── Misc third-party property data (optional, only used by legacy routes) ─
PROPERTY_API_KEY=
PROPERTY_API_VALUE=
PROPERTY_MARKET_API=
